{
	"manifest_version": 3,
	"name": "Deviation Lens",
	"version": "0.1.0",
	"description": "Find and download artwork images from DeviantArt at the best available quality.",
	"minimum_chrome_version": "141",
	"action": {
		"default_title": "Deviation Lens",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["activeTab", "sidePanel", "scripting", "downloads", "storage", "tabs"],
	"optional_host_permissions": ["*://*/*"],
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"host_permissions": ["*://*.deviantart.com/*", "*://*.wixmp.com/*"],
	"content_scripts": [
		{
			"matches": ["*://*.deviantart.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["popup.css", "sidebar.css", "sidebar.html", "icons/*"],
			"matches": ["*://*.deviantart.com/*"]
		}
	],
	"version_name": "0.1.0-alpha.1"
}

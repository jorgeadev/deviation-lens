{
  "name": "deviantart-image-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "pnpm monorepo for the DeviantArt Image Hunter browser extension and future apps.",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "check": "pnpm --filter @dah/extension run check",
    "test:smoke": "pnpm --filter @dah/tools run smoke",
    "test:e2e": "pnpm --filter @dah/tools run e2e",
    "test:e2e:profile": "pnpm --filter @dah/tools run e2e:profile",
    "test:visual": "pnpm --filter @dah/tools run e2e:visual",
    "test:sidebar": "pnpm --filter @dah/tools run e2e:sidebar"
  }
}
